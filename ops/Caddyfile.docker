# Caddy for the `https` profile in compose.yaml. Same headers as Caddyfile.example;
# the domain comes from DOMAIN in .env. Caddy runs with host networking and reaches
# the app on its loopback port (APP_PORT = PORT from .env, default 3000).
{$DOMAIN} {
	reverse_proxy 127.0.0.1:{$APP_PORT} {
		header_up X-Forwarded-For {remote_host}
	}

	request_body {
		max_size 8MB
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: http: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	}
}
