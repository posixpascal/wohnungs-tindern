# Scraper push target (scraper/push.ts). Local default: the app started with
# `bun run dev`. For a production deploy, change this to your https:// domain.
WOHNUNG_URL=http://127.0.0.1:3000
# >= 32 chars. `bun run setup` fills it in with a random hex token while empty.
INGEST_TOKEN=

# Server (app/)
PORT=3000
HOST=127.0.0.1
# Relative paths resolve against the repo root (from source) or the working
# directory (compiled binary). Production: use an absolute path.
DB_PATH=./data/wohnung.sqlite
# Local default: plain HTTP, so the session cookie must not require TLS.
# Production: set to true (served over https behind a reverse proxy).
COOKIE_SECURE=false
# Local default: the app is reached directly, not behind a proxy.
# Production: set to true only when sitting directly behind a trusted
# reverse proxy that sets X-Forwarded-For (e.g. Caddy).
TRUST_PROXY=false

# Optional: agent command for `bun run scrape` / `bun run scrape:headless`
# (default: Claude Code), e.g. for Codex:
# SCRAPE_CMD='codex "Use the wohnung-suche skill"'
# SCRAPE_HEADLESS_CMD='codex exec --full-auto "Use the wohnung-suche skill in headless mode"'
